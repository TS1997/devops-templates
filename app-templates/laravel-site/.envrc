#!/usr/bin/env bash

# Private inputs (github:ts1997/devops-templates) need a GitHub token before
# devenv fetches them. Reuses the gh CLI login.
if github_token="$(gh auth token 2>/dev/null)" && [[ -n "$github_token" ]]; then
  export NIX_CONFIG="extra-access-tokens = github.com=$github_token${NIX_CONFIG:+$'\n'$NIX_CONFIG}"
  log_status "GitHub token loaded for private inputs."
else
  log_error "No GitHub token found; private inputs will fail. Run 'gh auth login' and 'direnv reload'."
fi
unset github_token

eval "$(devenv direnvrc)"
use devenv
