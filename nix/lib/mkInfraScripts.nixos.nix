{ pkgs, lib }:
{
  # Root module directory, relative to the repo root.
  tofuDir ? "opentofu",
  # Root module output with everything Nix needs. Must not be sensitive.
  output ? "nix",
  # Generated file, relative to the repo root.
  file ? "infrastructure.nix",
}:
let
  # Shared by infra-sync and infra-check. The value_from_* functions write the
  # output's value to $tmp/value.json; value_from_plan also writes the paths
  # that are only known after apply to $tmp/unknown (one per line).
  # nix-instantiate comes from the caller's PATH (these run through nix run).
  common = ''
    root="$(git rev-parse --show-toplevel)"
    tofu_dir="$root/"${lib.escapeShellArg tofuDir}
    name=${lib.escapeShellArg output}
    file=${lib.escapeShellArg file}
    target="$root/$file"

    # Also holds plan files, which contain the variables (secrets).
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT

    message() {
      local level="$1"
      shift
      if [[ -n "''${GITHUB_ACTIONS:-}" ]]; then
        echo "::$level::$*"
      else
        echo "$level: $*" >&2
      fi
    }

    value_from_state() {
      # All outputs, so the sensitive flag can be checked.
      tofu -chdir="$tofu_dir" output -json | jq -e --arg name "$name" '
        .[$name] // error("OpenTofu output \($name) is missing; apply first")
        | if .sensitive then error("OpenTofu output \($name) is sensitive and must not be committed") else .value end
      ' > "$tmp/value.json"
      : > "$tmp/unknown"
    }

    value_from_plan() {
      # Only this object leaves jq: the plan JSON also contains the variables.
      tofu -chdir="$tofu_dir" show -json "$1" | jq -ce --arg name "$name" '
        .output_changes[$name] as $change
        | if $change == null or $change.actions == ["delete"] then
            error("OpenTofu output \($name) is missing from the configuration")
          elif .planned_values.outputs[$name].sensitive or $change.after_sensitive == true then
            error("OpenTofu output \($name) is sensitive and must not be committed")
          else
            {
              value: $change.after,
              unknown: (
                if $change.after_unknown == true then [$name]
                else [$change.after_unknown | paths(. == true) | [$name] + map(tostring) | join(".")]
                end
              )
            }
          end
      ' > "$tmp/plan.json"
      jq '.value' "$tmp/plan.json" > "$tmp/value.json"
      jq -r '.unknown[]' "$tmp/plan.json" > "$tmp/unknown"
    }

    render() {
      {
        echo "# Generated by infra-sync from the OpenTofu output \"$name\". Do not edit."
        nix-instantiate --eval --strict --argstr file "$tmp/value.json" \
          --expr '{ file }: builtins.fromJSON (builtins.readFile file)' \
          | nixfmt -
      } > "$tmp/rendered"
    }
  '';

  runtimeInputs = [
    pkgs.gitMinimal
    pkgs.jq
    pkgs.nixfmt
    pkgs.opentofu
  ];
in
{
  infra-sync = pkgs.writeShellApplication {
    name = "infra-sync";
    inherit runtimeInputs;
    text = common + ''
      if (( $# > 0 )); then
        echo "Usage: infra-sync" >&2
        exit 2
      fi

      # The plan itself goes to stderr, so it can be reviewed.
      tofu -chdir="$tofu_dir" plan -input=false -out="$tmp/plan" >&2
      value_from_plan "$tmp/plan"

      if [[ -s "$tmp/unknown" ]]; then
        echo >&2
        echo "Only known after apply:" >&2
        sed 's/^/  /' "$tmp/unknown" >&2
        echo "$file was not changed. Push the OpenTofu change alone, let CI apply it, then run infra-sync again." >&2
        exit 1
      fi

      render
      install -m 644 "$tmp/rendered" "$target"
      git -C "$root" diff --stat -- "$file"
      echo "Wrote $file (the output after applying the current config). Commit it together with the OpenTofu change." >&2
    '';
  };

  infra-check = pkgs.writeShellApplication {
    name = "infra-check";
    inherit runtimeInputs;
    text = common + ''
      case "''${1:-}" in
        "")
          value_from_state
          source="the applied OpenTofu output $name"
          ;;
        --plan)
          value_from_plan "''${2:?Usage: infra-check [--plan PLAN-FILE]}"
          source="the OpenTofu output $name in the plan"
          if [[ -s "$tmp/unknown" ]]; then
            message warning "Not checking $file: the plan has values that are only known after apply ($(paste -sd' ' "$tmp/unknown")). Run infra-sync after the apply and commit $file."
            exit 0
          fi
          ;;
        *)
          echo "Usage: infra-check [--plan PLAN-FILE]" >&2
          exit 2
          ;;
      esac

      render
      if ! diff -uN --label "$file (committed)" --label "$file (OpenTofu)" "$target" "$tmp/rendered"; then
        message error "$file differs from $source. Run infra-sync and commit $file."
        exit 1
      fi
      echo "$file matches $source." >&2
    '';
  };

  # e.g. `ssh-host --host=bravomedia --user=deploy -- systemctl status`
  ssh-host = pkgs.writeShellApplication {
    name = "ssh-host";
    runtimeInputs = [
      pkgs.gitMinimal
      pkgs.jq
      pkgs.openssh
    ];
    text = ''
      usage="Usage: ssh-host --host=HOST [--user=USER] [-- SSH-ARGS...]"
      host=""
      user="root"

      while (( $# > 0 )); do
        case "$1" in
          --host=*) host="''${1#*=}"; shift ;;
          --user=*) user="''${1#*=}"; shift ;;
          -h|--help) echo "$usage"; exit 0 ;;
          --) shift; break ;;
          --host|--user) echo "$usage" >&2; exit 1 ;;
          *) break ;;
        esac
      done

      if [[ -z "$host" ]]; then
        echo "$usage" >&2
        exit 1
      fi

      # nix-instantiate comes from the caller's PATH, like in infra-sync.
      target="$(git rev-parse --show-toplevel)/"${lib.escapeShellArg file}
      ip="$(nix-instantiate --eval --strict --json "$target" -A "nodes.$host.ip" | jq -r .)"
      exec ssh "$user@$ip" "$@"
    '';
  };
}
