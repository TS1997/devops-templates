{ pkgs, lib }:
{
  tofuDir ? "opentofu",
  # Root tofu module where infra information for nix is outputted.
  rootTofuOutput ? "nix",
  # Generated file, relative to the deploy repo root.
  file ? "infrastructure.nix",
}:
let
  # Shell-quoted, for interpolation into the scripts below.
  tofuDirArg = lib.escapeShellArg tofuDir;
  tofuOutputNameArg = lib.escapeShellArg rootTofuOutput;
  nixFileArg = lib.escapeShellArg file;

  commonRuntimeInputs = [
    pkgs.gitMinimal
    pkgs.jq
    pkgs.opentofu
  ];

  # print-message LEVEL TEXT...: a GitHub annotation in Actions, else stderr.
  print-message = pkgs.writeShellApplication {
    name = "print-message";
    text = ''
      level="$1"
      shift
      if [[ -n "''${GITHUB_ACTIONS:-}" ]]; then
        echo "::$level::$*"
      else
        echo "$level: $*" >&2
      fi
    '';
  };

  # get-value-from-state: prints the applied value of the output as JSON.
  get-value-from-state = pkgs.writeShellApplication {
    name = "get-value-from-state";
    runtimeInputs = commonRuntimeInputs;
    text = ''
      tofu_dir="$(git rev-parse --show-toplevel)/"${tofuDirArg}
      # All outputs, so the sensitive flag can be checked.
      tofu -chdir="$tofu_dir" output -json | jq -e --arg name ${tofuOutputNameArg} '
        # halt_error prints the message as is, without the "jq: error (at ...)" prefix.
        def fail(msg): "error: \(msg)\n" | halt_error(1);
        .[$name] // fail("OpenTofu output \($name) is not in the state yet. Apply first.")
        | if .sensitive then fail("OpenTofu output \($name) is sensitive and must not be committed") else .value end
      '
    '';
  };

  # get-output-from-plan PLAN-FILE: prints {"planned_state_after_apply":
  # <output after apply>, "attr_paths_known_after_apply": [<attribute paths in
  # the output, e.g. nix.nodes.web.ip>]}.
  get-output-from-plan = pkgs.writeShellApplication {
    name = "get-output-from-plan";
    runtimeInputs = commonRuntimeInputs;
    text = ''
      plan_file="$1"
      tofu_dir="$(git rev-parse --show-toplevel)/"${tofuDirArg}
      # Only this object leaves jq: the plan JSON also contains the variables.
      tofu -chdir="$tofu_dir" show -json "$plan_file" | jq -ce --arg name ${tofuOutputNameArg} '
        def fail(msg): "error: \(msg)\n" | halt_error(1);
        .output_changes[$name] as $change
        | if $change == null or $change.actions == ["delete"] then
            fail("OpenTofu output \($name) is missing from the configuration")
          elif .planned_values.outputs[$name].sensitive or $change.after_sensitive == true then
            fail("OpenTofu output \($name) is sensitive and must not be committed")
          else
            {
              planned_state_after_apply: $change.after,
              attr_paths_known_after_apply: (
                if $change.after_unknown == true then [$name]
                else [$change.after_unknown | paths(. == true) | [$name] + map(tostring) | join(".")]
                end
              )
            }
          end
      '
    '';
  };

  # render-infra-file JSON: prints the contents of the generated file.
  # nix-instantiate comes from the caller's PATH (these run through nix run).
  render-infra-file = pkgs.writeShellApplication {
    name = "render-infra-file";
    runtimeInputs = [ pkgs.nixfmt ];
    text = ''
      json="$1"
      tofu_output_name=${tofuOutputNameArg}
      echo "# Generated by infra-sync from the OpenTofu output \"$tofu_output_name\". Do not edit."
      nix-instantiate --eval --strict --argstr json "$json" \
        --expr '{ json }: builtins.fromJSON json' \
        | nixfmt -
    '';
  };
in
{
  infra-sync = pkgs.writeShellApplication {
    name = "infra-sync";
    runtimeInputs = commonRuntimeInputs ++ [
      get-output-from-plan
      render-infra-file
    ];
    text = ''
      if (( $# > 0 )); then
        echo "Usage: infra-sync" >&2
        exit 2
      fi

      root="$(git rev-parse --show-toplevel)"
      nix_file=${nixFileArg}

      # The plan file contains the variables (secrets).
      tmp="$(mktemp -d)"
      trap 'rm -rf "$tmp"' EXIT

      # The plan itself goes to stderr, so it can be reviewed.
      # -detailed-exitcode: 0 = no changes, 1 = error, 2 = changes to apply.
      plan_exit_code=0
      tofu -chdir="$root/"${tofuDirArg} plan -input=false -detailed-exitcode -out="$tmp/plan" >&2 \
        || plan_exit_code=$?
      if (( plan_exit_code == 1 )); then
        exit 1
      fi
      plan=$(get-output-from-plan "$tmp/plan")

      # Attribute paths in the output (for example nix.nodes.web.ip).
      attr_paths_known_after_apply=$(jq -r '.attr_paths_known_after_apply[]' <<< "$plan")
      if [[ -n "$attr_paths_known_after_apply" ]]; then
        echo >&2
        echo "Only known after apply:" >&2
        while IFS= read -r attr_path; do
          echo "  $attr_path" >&2
        done <<< "$attr_paths_known_after_apply"
        echo "$nix_file was not changed. Push the OpenTofu change alone, let CI apply it, then run infra-sync again." >&2
        exit 1
      fi

      planned_state_after_apply=$(jq '.planned_state_after_apply' <<< "$plan")
      rendered=$(render-infra-file "$planned_state_after_apply")
      printf '%s\n' "$rendered" > "$root/$nix_file"
      git -C "$root" diff --stat -- "$nix_file"
      echo >&2

      if (( plan_exit_code == 2 )); then
        echo "Wrote $nix_file from the plan, which is NOT applied yet." >&2
        echo "Commit $nix_file together with the OpenTofu change and let CI apply it." >&2
        echo "Ignore the tofu apply command above: infra-sync deletes its plan file." >&2
      else
        echo "Wrote $nix_file. The plan has no changes, so it matches the applied state." >&2
      fi
    '';
  };

  infra-check = pkgs.writeShellApplication {
    name = "infra-check";
    runtimeInputs = commonRuntimeInputs ++ [
      get-value-from-state
      render-infra-file
      print-message
    ];
    text = ''
      if (( $# > 0 )); then
        echo "Usage: infra-check" >&2
        exit 2
      fi

      root="$(git rev-parse --show-toplevel)"
      tofu_output_name=${tofuOutputNameArg}
      nix_file=${nixFileArg}

      value=$(get-value-from-state)
      source="the applied OpenTofu output $tofu_output_name"

      rendered=$(render-infra-file "$value")
      if ! diff -uN --label "$nix_file (committed)" --label "$nix_file (OpenTofu)" "$root/$nix_file" <(printf '%s\n' "$rendered"); then
        print-message error "$nix_file differs from $source. Run infra-sync and commit $nix_file."
        exit 1
      fi
      echo "$nix_file matches $source." >&2
    '';
  };

  # e.g. `ssh-host --host=bravomedia --user=deploy -- systemctl status`
  ssh-host = pkgs.writeShellApplication {
    name = "ssh-host";
    runtimeInputs = [
      pkgs.gitMinimal
      pkgs.jq
      pkgs.openssh
    ];
    text = ''
      usage="Usage: ssh-host --host=HOST [--user=USER] [-- SSH-ARGS...]"
      host=""
      user="root"

      while (( $# > 0 )); do
        case "$1" in
          --host=*) host="''${1#*=}"; shift ;;
          --user=*) user="''${1#*=}"; shift ;;
          -h|--help) echo "$usage"; exit 0 ;;
          --) shift; break ;;
          --host|--user) echo "$usage" >&2; exit 1 ;;
          *) break ;;
        esac
      done

      if [[ -z "$host" ]]; then
        echo "$usage" >&2
        exit 1
      fi

      # nix-instantiate comes from the caller's PATH, like in infra-sync.
      target="$(git rev-parse --show-toplevel)/"${lib.escapeShellArg file}
      ip="$(nix-instantiate --eval --strict --json "$target" -A "nodes.$host.ip" | jq -r .)"
      exec ssh "$user@$ip" "$@"
    '';
  };
}
