{ pkgs, lib }:
{
  # Shell expression for the age identity, e.g. ''"$AGE_IDENTITY"''
  ageKey,
  # Encrypted JSON object. A Nix path (copied to the store, still encrypted) or a
  # shell expression such as "$ROOT_DIR/secrets/tokens.json.age".
  tokensJsonAgeFilePath,
  # More encrypted JSON objects merged in before tokensJsonAgeFilePath (which
  # wins on conflicts), e.g. [ devops-templates.lib.sharedTokensFile ].
  extraTokensJsonAgeFilePaths ? [ ],
  sshKeyAgeFilePath ? null,
  # Format: "json_key:ENV_VAR_NAME". The json key may be a dotted path
  # (a.b.c). Non-string values (objects, numbers) are exported as compact JSON.
  variablePairs,
  # Shell expression for where the decrypted exports are written. Must not be
  # committed: .tokens.sh is gitignored in deploy repos, devenv projects use
  # .devenv/state.
  tokensFile ? "\"\${ROOT_DIR:-$(pwd)}/.tokens.sh\"",
}:
let
  pairsStr = lib.concatMapStringsSep " " lib.escapeShellArg variablePairs;

  tokens = pkgs.writeShellScriptBin "tokens" ''
    set -euo pipefail
    ROOT_DIR="''${ROOT_DIR:-$(pwd)}"
    tokens_file=${tokensFile}
    source_files=(${
      lib.concatMapStringsSep " " (path: ''"${path}"'') (
        extraTokensJsonAgeFilePaths ++ [ tokensJsonAgeFilePath ]
      )
    })
    variable_pairs_to_export=(${pairsStr})

    # Changes when the encrypted files or the requested variables change
    fingerprint="$(
      {
        for source_file in "''${source_files[@]}"; do
          ${pkgs.coreutils}/bin/sha256sum < "$source_file"
        done
        printf '%s\n' "''${variable_pairs_to_export[@]}"
      } | ${pkgs.coreutils}/bin/sha256sum | ${pkgs.coreutils}/bin/cut -d' ' -f1
    )"

    # tokens --is-fresh: exit 0 when $tokens_file matches the current inputs
    if [[ "''${1:-}" == "--is-fresh" ]]; then
      [[ -f "$tokens_file" ]] && ${pkgs.gnugrep}/bin/grep -qxF "# fingerprint=$fingerprint" "$tokens_file"
      exit
    fi

    tokens_json='{}'
    for source_file in "''${source_files[@]}"; do
      if ! file_json="$(${pkgs.age}/bin/age -d -i ${ageKey} "$source_file")"; then
        echo "tokens: could not decrypt $source_file" >&2
        exit 1
      fi
      # Deep merge via stdin, so no secret ends up in a process argument
      tokens_json="$(printf '%s\n%s\n' "$tokens_json" "$file_json" | ${pkgs.jq}/bin/jq -s '.[0] * .[1]')"
    done
    unset file_json

    # The file holds plaintext secrets: owner-only, written atomically
    umask 077
    mkdir -p "$(dirname "$tokens_file")"
    tmp_file="$(mktemp "$tokens_file.XXXXXX")"
    trap 'rm -f "$tmp_file"' EXIT

    {
      echo "# Generated by 'tokens'. Contains secrets, do not edit or commit."
      echo "# fingerprint=$fingerprint"
      for pair in "''${variable_pairs_to_export[@]}"; do
        json_key="''${pair%%:*}"
        env_var="''${pair##*:}"
        if [[ ! "$env_var" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
          echo "tokens: invalid variable name in pair '$pair'" >&2
          exit 1
        fi
        # @sh quotes the value, so JSON, quotes and $ survive sourcing
        value="$(${pkgs.jq}/bin/jq -r --arg k "$json_key" \
          'getpath($k | split(".")) // empty | if type == "string" then . else tojson end | @sh' \
          <<<"$tokens_json")"
        if [[ -n "$value" ]]; then
          printf 'export %s=%s\n' "$env_var" "$value"
        else
          echo "tokens: '$json_key' not found, $env_var not set" >&2
        fi
      done
    } > "$tmp_file"

    mv "$tmp_file" "$tokens_file"
    trap - EXIT
    echo "Tokens written to $tokens_file"
  '';

  # Must be sourced (`source set-environment`) to export into the calling shell
  setEnvironment = pkgs.writeShellScriptBin "set-environment" ''
    _tokens_file=${tokensFile}

    if ! ${tokens}/bin/tokens --is-fresh; then
      echo -e "\033[0;33mTokens missing or outdated, regenerating...\033[0m"
      ${tokens}/bin/tokens || true
    fi

    if [[ -f "$_tokens_file" ]]; then
      echo -e "\033[0;32mTokens found, setting environment.\033[0m"
      # shellcheck disable=SC1090
      source "$_tokens_file"
    else
      echo -e "\033[0;31m$_tokens_file not found and could not be generated.\033[0m"
    fi
    unset _tokens_file
  '';
in
{
  inherit tokens setEnvironment;

  # Prints $AGE_IDENTITY, or the ~/.ssh key listed in lib.masterIdentity.people
  selectAgeIdentity = pkgs.callPackage ../pkgs/select-age-identity.nix { };
}
// lib.optionalAttrs (sshKeyAgeFilePath != null) {
  addSshKey = pkgs.writeShellScriptBin "add-ssh-key" ''
    ssh_key=$(age --decrypt --identity ${ageKey} ${sshKeyAgeFilePath})
    ssh-add <(echo "$ssh_key")
  '';
}
