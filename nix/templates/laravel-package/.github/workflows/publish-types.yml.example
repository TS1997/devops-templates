# Example generated types publishing workflow.
# To enable it, rename this file to publish-types.yml.
# The workflow runs in the devenv shell. It needs the CI_AGE_KEY secret, which
# decrypts the shared tokens into COMPOSER_AUTH and BRAVO_NPM_TOKEN (read by
# resources/types/.npmrc).

name: Publish Types

on:
  push:
    tags:
      - "*"
  workflow_dispatch:

concurrency:
  group: publish-types-${{ github.ref }}
  cancel-in-progress: false

jobs:
  publish-types:
    uses: TS1997/devops-templates/.github/workflows/laravel-publish-types.yml@master
    with:
      environment: "production"
    secrets:
      CI_AGE_KEY: ${{ secrets.CI_AGE_KEY }}
