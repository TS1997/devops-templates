#!/usr/bin/env php
<?php

// Set cache driver to array to avoid requiring a package database connection.
putenv('CACHE_STORE=array');
$_ENV['CACHE_STORE'] = 'array';
$_SERVER['CACHE_STORE'] = 'array';

$testbenchPath = getcwd() . '/vendor/bin/testbench';

if (! file_exists($testbenchPath)) {
    fwrite(STDERR, "Error: vendor/bin/testbench not found. Run 'composer install' first.\n");

    exit(1);
}

$_SERVER['argv'] = $argv = [$testbenchPath, ...array_slice($argv, 1)];
$_SERVER['argc'] = $argc = count($argv);

// Run in-process: proxying through passthru() buffers stdout in 4 KB blocks and stalls MCP responses.
require $testbenchPath;
